{
  "expo": {
    "name": "PowerUp",
    "slug": "memora",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "powerup",
    "userInterfaceStyle": "automatic",

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gowthamcoder.apppowerup",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "PowerUp uses the microphone for speaking exercises and mock interviews."
      }
    },
    "android": {
      "package": "com.gowthamcoder.apppowerup",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.RECORD_AUDIO", "android.permission.MODIFY_AUDIO_SETTINGS"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      "expo-secure-store",
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "PowerUp uses the microphone for speaking exercises and mock interviews."
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "PowerUp uses the camera for video interview practice.",
          "microphonePermission": "PowerUp uses the microphone for your voice interview with the AI interviewer."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "komalvardhanlolugu-team",
    "updates": {
      "url": "https://u.expo.dev/ee1797f2-ebb5-42a5-9caf-21a4201b3662"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ee1797f2-ebb5-42a5-9caf-21a4201b3662"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
