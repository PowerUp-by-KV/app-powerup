{
  "expo": {
    "name": "PowerUp",
    "slug": "powerup",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "powerup",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gowthamcoder.apppowerup",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "PowerUp uses the microphone for speaking exercises and mock interviews."
      }
    },
    "android": {
      "package": "com.gowthamcoder.apppowerup",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.RECORD_AUDIO", "android.permission.MODIFY_AUDIO_SETTINGS"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      "expo-secure-store",
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-av",
        {
          "microphonePermission": "PowerUp uses the microphone for speaking exercises and mock interviews."
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "PowerUp uses the camera for video interview practice.",
          "microphonePermission": "PowerUp uses the microphone for your voice interview with the AI interviewer."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "deepak",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "703b4f76-f53c-44a4-af31-cf8ddf5ec093"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
