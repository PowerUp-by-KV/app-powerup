# Base URL of the API, ending in /api - NOT /api/v1.
# Every endpoint in src/services/ already prefixes its own `v1/`, so adding the version
# here produces /api/v1/v1/... and every single request 404s, with no visible error.
EXPO_PUBLIC_API_URL=https://<azure-container-app-url>/api

# Web-only admin panel at /adminpowerup (internal tool, hardcoded password gate).
# Must NOT be prefixed EXPO_PUBLIC_ - that gets inlined into the client bundle,
# shipping the password in plaintext to anyone who opens the web build's source.
ADMIN_PANEL_PASSWORD=change-me-before-deploy

# Required for Google sign-in - the login screen white-screens without it
# ("Client Id property 'webClientId' must be defined to use Google auth on this platform").
# Same value as the web client id in eas.json.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

EXPO_PUBLIC_GOOGLE_DEVELOPER_KEY=
EXPO_PUBLIC_DROPBOX_APP_KEY=
