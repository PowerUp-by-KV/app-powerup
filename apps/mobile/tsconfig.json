{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "module": "esnext",
    "paths": {
      "@/*": ["./src/*"],
      "@app/*": ["./app/*"],
      "@powerup/shared": ["../../packages/shared/src/index.ts"],
      "@powerup/shared/*": ["../../packages/shared/src/*"],
      "@app-powerup/shared": ["../../packages/shared/src/index.ts"],
      "@app-powerup/shared/*": ["../../packages/shared/src/*"],
      "@app-powerup/shared/types": ["../../packages/shared/src/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "nativewind-env.d.ts"]
}
