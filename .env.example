# API Configuration
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Feature Flags
EXPO_PUBLIC_ENABLE_ANALYTICS=false

# App Environment (development | staging | production)
EXPO_PUBLIC_APP_ENV=development

EXPO_ACCESS_TOKEN=your_access_token_here //login and get the token

EXPO_REFRESH_TOKEN=your_refresh_token_here //login and get the refresh token
